{
  "name": "flowpilot",
  "version": "1.0.0",
  "private": true,
  "description": "A workflow automation platform powered by AI",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -k -n web,api,worker \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:web": "pnpm --filter @flowpilot/web dev",
    "dev:api": "pnpm --filter @flowpilot/api start:dev",
    "dev:worker": "pnpm --filter @flowpilot/worker start:dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2"
  }
}
